*.bak
*.orig
*~

# Test coverage files
*.cov
*.profraw
*.pprof

## Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Logs
*.log

# Docker related files (if you are using Docker)
docker-compose.override.yml
.dockerenv

# Go workspace file
go.work
go.work.sum

.venv