# Binary files
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
*.test

# Build directories
bin/
pkg/

# Dependencies (vendor directory, if using Go Modules with vendoring)
vendor/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
